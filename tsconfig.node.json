{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron/**/*", "src/domain/**/*", "src/persistence/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "noImplicitAny": true,
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}
