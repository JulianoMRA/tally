{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/renderer/**/*", "src/domain/**/*", "src/persistence/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@domain/*": ["src/domain/*"],
      "@persistence/*": ["src/persistence/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
